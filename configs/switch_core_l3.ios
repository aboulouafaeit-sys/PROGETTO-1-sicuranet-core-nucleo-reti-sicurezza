! ==============================================================================
! Core / Distribution Multilayer Switch (Cisco Catalyst 3560 / 3650)
! Role: Hardware-based Inter-VLAN Routing + SVI Routing + DHCP Relay
! ==============================================================================

enable
configure terminal
hostname SW-CORE-L3

! 1. Enable IPv4 Routing
ip routing

! 2. Create VLANs
vlan 10
 name MANAGEMENT
vlan 20
 name DATA_STAFF
vlan 30
 name VOICE_VOIP
vlan 50
 name SERVERS_DC
vlan 60
 name FACTORY_IOT_TVS
exit

! 3. Configure Switched Virtual Interfaces (SVIs)
interface Vlan10
 description DEFAULT_GATEWAY_MGMT
 ip address 192.168.10.1 255.255.255.0
 no shutdown

interface Vlan20
 description DEFAULT_GATEWAY_DATA
 ip address 192.168.20.1 255.255.255.0
 no shutdown

interface Vlan30
 description DEFAULT_GATEWAY_VOICE
 ip address 192.168.30.1 255.255.255.0
 no shutdown

interface Vlan50
 description DEFAULT_GATEWAY_SERVERS
 ip address 192.168.50.1 255.255.255.0
 no shutdown

interface Vlan60
 description DEFAULT_GATEWAY_FACTORY_TVS
 ip address 192.168.60.1 255.255.255.0
 no shutdown

! 4. Trunk Uplinks to Downstream Switches
interface range GigabitEthernet0/1 - 2
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,50,60
 no shutdown

do write memory
